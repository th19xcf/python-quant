{
  "version": 1,
  "description": "数据新鲜度检查registry：每类数据的权威新鲜度字段、正常更新频率与分级阈值。所有阈值只在此文件维护，代码内不写死。覆盖统计的两种「最新」口径必须分清：latest_glob_distinct 取 glob 中 mtime 最新那一份文件内的去重数，口径是「最新文件」；latest_as_of_distinct 取单表内 as_of 最大那一层的去重数，口径是「最新数据」。两者在「日期文件族」下恰好同值，一旦改成单表 history 就不再等价——全历史并集或 parquet_distinct 会把已退市代码也算进来，使覆盖率虚高，故状态快照族一律用 latest_as_of_distinct。",
  "defaults": {
    "anchor": "quotes_end",
    "anchor_note": "滞后锚点：quotes_end 用行情末日（相对锚点，盘中不误报）；today 用系统当天（绝对锚点）。与 freshness_check 统一用 quotes_end。",
    "holidays": [],
    "holiday_note": "交易日按周一至周五近似；如遇法定节假日，把日期以 YYYY-MM-DD 加入 holidays，避免误报超期。",
    "coverage": {
      "min_ratio": 0.95,
      "critical_ratio": 0.8,
      "note": "覆盖门禁默认阈值唯一真源：条目未写 min_ratio/critical_ratio 时取这里的值；确需不同门槛必须在条目 coverage.why 写明理由，否则解析报错。"
    }
  },
  "datasets": [
    {
      "key": "quotes_stock",
      "label": "A股日线行情",
      "category": "行情",
      "freshness_field": "daily_index.end",
      "source": {
        "kind": "meta_max",
        "path": "meta/daily_index.parquet",
        "filter": {"column": "data_type", "value": "stock"},
        "column": "end"
      },
      "cadence": {
        "unit": "trading_day",
        "expected_interval": 1,
        "warn_multiple": 1,
        "critical_multiple": 3,
        "label": "每交易日"
      },
      "coverage": {
        "count": {
          "kind": "meta_distinct",
          "path": "meta/daily_index.parquet",
          "filter": {"column": "data_type", "value": "stock"},
          "column": "ts_code"
        },
        "expected": {
          "kind": "latest_as_of_distinct",
          "path": "meta/st_status/st_status_history.parquet",
          "as_of_column": "as_of",
          "column": "code"
        }
      },
      "note": "行情末日期来自 daily_index 元数据；覆盖分母取最新 ST 状态快照中的上市股票数。"
    },
    {
