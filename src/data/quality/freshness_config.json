{
  "version": 1,
  "description": "数据新鲜度检查registry：每类数据的权威新鲜度字段、正常更新频率与分级阈值。所有阈值只在此文件维护，代码内不写死。",
  "defaults": {
    "holidays": [],
    "holiday_note": "交易日按周一至周五近似；如遇法定节假日，把日期以 YYYY-MM-DD 加入 holidays，避免误报超期。"
  },
  "datasets": [
    {
      "key": "quotes_stock",
      "label": "A股日线行情",
      "category": "行情",
      "freshness_field": "daily_index.end",
      "source": {
        "kind": "meta_max",
        "path": "meta/daily_index.parquet",
        "filter": {"column": "data_type", "value": "stock"},
        "column": "end"
      },
      "cadence": {
        "unit": "trading_day",
        "expected_interval": 1,
        "warn_multiple": 1,
        "critical_multiple": 3,
        "label": "每交易日"
      },
      "coverage": {
        "count": {
          "kind": "meta_distinct",
          "path": "meta/daily_index.parquet",
          "filter": {"column": "data_type", "value": "stock"},
          "column": "ts_code"
        },
        "expected": {
          "kind": "latest_glob_distinct",
          "path_glob": "meta/st_status/st_status_*.parquet",
          "column": "code"
        },
        "min_ratio": 0.95,
        "critical_ratio": 0.8
      },
      "note": "行情末日期来自 daily_index 元数据；覆盖分母取最新 ST 状态快照中的上市股票数。"
    },
    {
      "key": "quotes_index",
      "label": "指数日线行情",
      "category": "行情",
      "freshness_field": "daily_index.end",
