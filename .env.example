# ==============================================================================
# 中国股市量化分析系统 —— 环境变量模板
# ==============================================================================
#
# 使用方式：
#   1. 复制本文件为 .env（已被 .gitignore 保护，不会被提交）
#   2. 填入实际的数据库凭据与通达信数据路径
#   3. 留空的项将使用 src/utils/config.py 中的默认值
#
# 配置说明：系统采用 pydantic_settings BaseSettings，支持 __ 嵌套分隔符
# （如 DATABASE__HOST → database.host）。完整字段说明见 config.py 内联文档。
# ==============================================================================


# ------------------------------------------------------------------------------
# 数据库（MySQL 8+/9）
# ------------------------------------------------------------------------------
# 必填：HOST / PORT / USERNAME / DATABASE
#       如果数据库为空，DataManager 会自动建表；首次回测前需先导入行情数据
DATABASE__HOST=localhost
DATABASE__PORT=3306
DATABASE__USERNAME=root
DATABASE__PASSWORD=
DATABASE__DATABASE=stock_quant
DATABASE__CHARSET=utf8mb4
# MySQL TLS CA 证书路径；留空不启用 TLS（内网明文）。接实盘资金接口前必须填写
DATABASE__SSL_CA=
DATABASE__POOL_SIZE=10
# 池满后可再开的临时连接数；设为 0 则达到 pool_size 后限制在 pool_timeout 内等待
DATABASE__MAX_OVERFLOW=10
# 池满后获取连接的最大等待秒数，超时抛 QueuePool 上限错误而不是无限阻塞
DATABASE__POOL_TIMEOUT=30
DATABASE__POOL_RECYCLE=3600


# ------------------------------------------------------------------------------
# 数据
# ------------------------------------------------------------------------------
# 必填：DATA__TDX_DATA_PATH
#       Windows 通达信默认路径类似 H:\zxzq\vipdoc；Linux/WSL 无通达信则留空，
#       仅使用 AkShare / BaoStock 在线数据源
DATA__TDX_DATA_PATH=
DATA__UPDATE_INTERVAL=3600
DATA__MAX_WORKERS=4


# ------------------------------------------------------------------------------
# 日志
# ------------------------------------------------------------------------------
LOG__LEVEL=INFO
LOG__FILE_PATH=logs/app.log
LOG__ROTATION=10 MB
LOG__RETENTION=30 days
LOG__COMPRESSION=zip
