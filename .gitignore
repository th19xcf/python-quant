# 本地临时脚本与基准/调试产物（一次性，不入库）
tmp/

# 研究中间产物（可由 research/events 脚本重建，体积大）
research/events/data/announcement_event_level_car.csv
research/events/data/announcements_partial.parquet

# 事件合并中间件（由月度分片合并生成，可重建，不入库）
research/events/data/*/_merged_for_import.parquet

# 研究数据不入库：Git 只管代码、脚本、文档与小体积元数据，数据安全靠 G:\git\python-quant 镜像 + _backup 快照
research/events/data/**/*.parquet

# 本地凭证目录（tushare token 等敏感信息，仅本机保存，禁止入库）
.secrets/
