scripts/check_399260.py
scripts/correct_399967.py
scripts/correct_index_names.py

# 本地 Parquet 列存（行情/因子/分红，部分不可重建，见 tools/backup_critical_assets.py）
data/local_store/

# 不可重建资产的同盘备份副本（生产请把 --dest 指向另一块盘/另一台机器）
backups/

